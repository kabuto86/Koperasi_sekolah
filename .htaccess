# Keselamatan (B14): tiada senarai folder; fail tersembunyi (.git, .env), dokumen & SQL tidak dihidang.
# Folder dalaman (core/, jobs/, config/, storage/, database/, tools/, DOC/ …) ada .htaccess "Require all denied" sendiri.
Options -Indexes
<FilesMatch "(^\.|\.(md|sql|log|lock|key|tmp|bak|dist|example\.php)$)">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.(git|svn|hg|env)(/|$)

# URL store cantik (B6): /{slug}/ dan /{slug}/{halaman} → store/index.php. Aktifkan juga config pretty_store_urls = true.
# Folder & fail sebenar (owner/, vendor/, api/, assets/ …) tidak terjejas. Perlu Apache mod_rewrite.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]{1,80})/?$ store/index.php?school=$1 [QSA,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]{1,80})/([a-z-]{1,40})/?$ store/index.php?school=$1&page=$2 [QSA,L]
</IfModule>
